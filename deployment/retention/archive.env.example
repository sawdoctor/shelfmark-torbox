# No credentials belong in the repository. Existing Shelfmark settings are read
# by the job; TORBOX_API_KEY_FILE is an optional path to a private token file.
SHELFMARK_CONFIG_DIR=/home/sawdoctor/docker/shelfmark-torbox/config
TORBOX_AUDIOBOOK_LIBRARY=/mnt/usenet_scratch/audiobookshelf-test/audiobooks
TORBOX_MOUNT_PATH=/mnt/torbox-audiobooks
TORBOX_VAULT_MOUNT=/mnt/gdrive-torbox-archive
TORBOX_VAULT_REMOTE=gdrive:Shelfmark-TorBox-Archive
TORBOX_ARCHIVE_STATE_DIR=/home/sawdoctor/.local/state/torbox-audiobooks
TORBOX_ARCHIVE_MAX_BACKUPS=2
# Normally detected from the existing TorBox mount with findmnt. If the mount
# uses --fsname, set this to the exact remote:path in its rclone mount command.
# TORBOX_SOURCE_REMOTE=torbox-audiobooks:existing-root-path
